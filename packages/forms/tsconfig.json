{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@workspace/ui": ["../ui/src/index.ts"],
      "@workspace/ui/*": ["../ui/src/*"],
    },
  },
  "include": ["./src"],
  "exclude": ["node_modules", "dist"],
}
