{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@workspace/ui/*": ["./src/*"],
      "@workspace/types/*": ["../types/src/*"],
    },
  },
  "include": [".", "../forms/src/forms", "../forms/src/fields"],
  "exclude": ["node_modules", "dist"],
}
