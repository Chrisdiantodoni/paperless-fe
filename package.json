{
  "name": "paperless",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:admin": "turbo dev --filter=paperless-admin",
    "dev:admin:build": "turbo build --filter=paperless-admin",
    "dev:user": "turbo dev --filter=paperless-user",
    "dev:user:build": "turbo build --filter=paperless-user",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.15",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "dependencies": {
    "axios": "^1.17.0",
    "js-cookie": "^3.0.8"
  }
}
